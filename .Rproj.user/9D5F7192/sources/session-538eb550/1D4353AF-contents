url: https://github.com/Yangzhen1999/wsMed

template:
  bootstrap: 5
  bootswatch: flatly
  params:
    copy_vignettes: true

navbar:
  structure:
    left: [home, reference, articles, news]
    right: [github]
  components:
    home:
      text: "Home"
      href: index.html
    reference:
      text: "Functions"
      href: reference/index.html
    articles:
      text: "Tutorials"
      menu:
        - text: "Introduction to wsMed"
          href: articles/wsMed.html
        - text: "Using printGM() to Generate SEM Models"
          href: articles/printGM.html
        - text: "Parallel Mediation (P)"
          href: articles/GenerateModelP.html
        - text: "Chained Mediation (CN)"
          href: articles/GenerateModelCN.html
        - text: "Combined Parallel and Chained (CP)"
          href: articles/GenerateModelCP.html
        - text: "Parallel + Chained (PC)"
          href: articles/GenerateModelPC.html
        - text: "Comparison: MEMORE 3.0 vs wsMed"
          href: articles/MEMORE_vs_wsMed.html
    news:
      text: "Changelog"
      href: news/index.html
    github:
      icon: fab fa-github
      href: https://github.com/Yangzhen1999/wsMed
      aria-label: "GitHub Repository"

reference:
  - title: "Main Functions"
    desc: "Core functions for within-subject mediation analysis"
    contents:
      - wsMed
      - print.wsMed
      - printGM
  - title: "Model Generation"
    desc: "Functions for generating SEM syntax for different mediation structures"
    contents:
      - GenerateModelP
      - GenerateModelCN
      - GenerateModelCP
      - GenerateModelPC
  - title: "Missing Data and Imputation"
    desc: "Functions to handle missing data with multiple imputation"
    contents:
      - ImputeData
      - PrepareMissingData
      - RunMCMIAnalysis
      - MICombineWrapper
  - title: "Monte Carlo and Utility Wrappers"
    desc: "Wrappers used in Monte Carlo estimation"
    contents:
      - MCMI2
      - MCDefWrapper
      - ThetaHatWrapper
      - ThetaHatStarWrapper
      - TestPositiveDefinitewrapper
      - TotalAdjwrapper
  - title: "Data and Utility"
    contents:
      - PrepareData
      - ARIVwrapper
      - example_data
