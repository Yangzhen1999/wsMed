data("Tal.Or", package = "psych")
df <- mice::ampute(Tal.Or)$amp

# Monte Carlo (Multiple Imputation) ----------------------------------------
## Multiple Imputation -----------------------------------------------------
mi <- mice::mice(
  data = df,
  print = FALSE,
  m = 5L, # use a large value e.g., 100L for actual research,
  seed = 42
)

## Fit Model in lavaan -----------------------------------------------------
model <- "
  reaction ~ cp * cond + b * pmi
  pmi ~ a * cond
  cond ~~ cond
  indirect := a * b
  direct := cp
  total := cp + (a * b)
"
library(lavaan)
fit <- sem(data = df, model = model) # use default listwise deletion

## MCMI() ------------------------------------------------------------------
library(semmcci)
unstd <- MCMI(
  fit,
  mi = mi,
  R = 5L, # use a large value e.g., 20000L for actual research
  alpha = 0.05
)

MCStd2(unstd)

#' # Example dataset with missing values
 data(example_data)
 set.seed(123)
 example_dataN <- mice::ampute(
    data = example_data,
    prop = 0.1,
    )$amp

#'
#' # Example SEM model
 sem_model <- "
   Ydiff ~ cp * 1 + b1 * M1diff
   M1diff ~ a1 * 1
   indirect := a1 * b1
   total := cp + indirect
   
   
 "
 fit <- sem(data = example_data, model = sem_model)
 
 fit_u <- semboottools::store_boot(
   fit,
   do_bootstrapping = TRUE,
   R = 1001,
   iseed = 1223
 )
 
 alpha <-  0.01
 ustd_result <- semboottools::parameterEstimates_boot(
   level = 1-alpha,
   object = fit_u,
   boot_pvalue = TRUE
 )
 
 
 
 
 
 # Perform Monte Carlo analysis with multiple imputation
 result <- RunMCMIAnalysis(
   data_missing =  example_dataN,
   m = 5,
   method = "pmm",
   seed = 123,
   M_C1 = c("A2", "B2"),
   M_C2 = c("A1", "B1"),
   Y_C1 = "C2",
   Y_C2 = "C1",
   sem_model = sem_model,
   R = 1000,
   alpha = c(0.05, 0.01)
 )

 

#'
MCStd2(result)