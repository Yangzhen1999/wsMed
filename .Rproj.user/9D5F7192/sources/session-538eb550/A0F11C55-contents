  cat("\n*************** MONTE CARLO CONFIDENCE INTERVALS (FIML) ***************\n")
  # 提取 alpha 参数
  alpha <- x$alpha  # 假设在 wsMed 输出中包含 alpha 参数
  if (is.null(alpha)) {
