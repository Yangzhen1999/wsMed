mean_n2i <- mean(dat_copy$n2i)
mean_n1i
mean_n2i
dat_copy$n1i <- mean_n1i
dat_copy$n2i <- mean_n2i
library(metafor)
dat_copy_smd <- escalc(measure = "SMD",
                       m1i = m1i,
                       m2i = m2i,
                       sd1i = sd1i,
