library(lavaan)
library(semboottools)

## 0. 示范数据 & 显变量中介模型
set.seed(1234)
n <- 1000
x <- runif(n) - 0.5
m <- 0.20 * x + rnorm(n)
y <- 0.17 * m + rnorm(n)
dat <- data.frame(x, y, m)

mod <- '
  m ~ a * x
  y ~ b * m + cp * x
  ab := a*b
  total := a*b + cp
'

fit0 <- sem(mod, data = dat, fixed.x = FALSE)

## 1. 做 bootstrap；一定记得 do_bootstrapping = TRUE
fit_b <- store_boot(fit0, R = 1500, do_bootstrapping = TRUE)

## 2. 直接取出抽样矩阵：lavInspect(fit_b, "boot") 就行
theta_raw <- lavInspect(fit_b, "boot")   # 维度: 1500 × 5
#   若你的 lavaan 版本旧，或者想手动：
#   theta_raw <- slot(fit_b, "boot")
#   
#   
#   
head(theta_raw[, 1:3])
## 3. 过滤失败 replicates（可选）
fail_idx <- lavInspect(fit_b, "boot.fails")   # 可能是整数向量或 integer(0)
if (length(fail_idx)) theta_raw <- theta_raw[-fail_idx, , drop = FALSE]

## 4. 转置，让行 = 抽样、列 = 系数
theta <- t(theta_raw)

## 5. 列名映射：必须用和 Monte-Carlo 分支同一个函数
#    这里举例占位：把 "m~x" → "a"、"y~m" → "b"、"y~x" → "cp"……
lav2coef <- function(x) switch(x,
                               "m~x" = "a", "y~m" = "b", "y~x" = "cp", "ab" = "ab", "total" = "total", x)
colnames(theta) <- vapply(colnames(theta), lav2coef, character(1))

## 6. 现在 theta 就是 nDraw × nCoef 的 θ-矩阵
dim(theta)
