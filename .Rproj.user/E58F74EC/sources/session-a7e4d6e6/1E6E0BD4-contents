make_theta_from_sbt <- function(fit_b,
                                label_fun,
                                which_mat = c("ustd", "std"),
                                add_def   = FALSE) {
  
  which_mat <- match.arg(which_mat)
  ext <- slot(fit_b, "external")
  
  raw <- switch(which_mat,
                ustd = ext$sbt_boot_ustd,
                std  = ext$sbt_boot_std
  )
  if (is.null(raw) || !is.matrix(raw))
    stop("找不到 ", which_mat, " 抽样矩阵；请确认 store_boot() 正常运行。")
  
  # 若要把 := 参数一起放进 θ-矩阵
  if (add_def && !is.null(ext$sbt_boot_def)) {
    raw <- cbind(raw, ext$sbt_boot_def)
  }
  
  theta <- t(raw)   # 行 = 抽样，列 = 系数
  
  colnames(theta) <- vapply(colnames(theta), label_fun, character(1))
  theta
}


# 你的标签转换函数（示例占位）

# 提取非标准化 θ-矩阵
theta_boot <- make_theta_from_sbt(fit_b, lav2coef, which_mat = "ustd")

