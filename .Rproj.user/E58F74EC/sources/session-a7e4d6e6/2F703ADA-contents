```{r}
vo_out_1 <- uniR1(r_matrix,
                  n_vector)
vo_out_1

mod_tra <-
"
bi ~ att + sn
beh ~ bi
att ~~ sn
"
vo_out_2 <- uniR2lavaan(vo_out_1, mod_tra)
summary(vo_out_2, fit.measures = TRUE)
```

