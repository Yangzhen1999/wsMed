```{r}
r_to_matrix <- function(x, vnames) {
    out <-  metaSEM::vec2symMat(unlist(x),
                                diag = FALSE)
    colnames(out) <- vnames
    rownames(out) <- vnames
    out
}
```

```{r}
dat[3,3:8]
r_to_matrix(dat[3,3:8],
            vnames = c("att","sn","bi","beh"))
```


```{r}
r_matrix <- apply(dat[, 3:8],
                  MARGIN = 1,
                  r_to_matrix,
                  vnames = c("att", "sn", "bi", "beh"),
                  simplify = FALSE)
names(r_matrix) <- dat$study
head(r_matrix)
```

```{r}
