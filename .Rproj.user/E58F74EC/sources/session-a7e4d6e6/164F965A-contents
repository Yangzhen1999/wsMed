### wsMed Analysis Report - no W
```{r, echo=FALSE}
library(wsMed)
result1 <- wsMed(
  data = dat_clean, #dataset
  M_C1 = c("TSRQ_T1","WEMBS_T1"), # A1/B1 is A/B mediator variable in condition 1
  M_C2 = c("TSRQ_T2","WEMBS_T2"), # A2/B2 is A/B mediator variable in condition 2
  Y_C1 = "DASSS_T1", # C1 is outcome variable in condition 1
  Y_C2 = "DASSS_T2", # C2 is outcome variable in condition 2
  form = "P", # Parallel mediation
  ci_method ="mc",
  seed = 123
)
print(result1,digits=4)
```

