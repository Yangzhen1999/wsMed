library(tools)
package_exports <- function(path = ".") {
files <- list.files(file.path(path, "R"), full.names = TRUE)
exports <- unique(unlist(lapply(files, function(file) {
lines <- readLines(file, warn = FALSE)
fun_names <- character(0)
for (i in seq_along(lines)) {
if (grepl("^#' @export", lines[i])) {
next_line <- lines[i + 1]
name <- gsub(" <-.*", "", next_line)
fun_names <- c(fun_names, name)
}
}
return(fun_names)
})))
exports
}
package_exports()
