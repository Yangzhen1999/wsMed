# 加载必要的库
library(ggplot2)
library(plotly)
install.packages("plotly")
library(plotly)
# 生成数据
X1 <- seq(-3, 3, length.out = 30)  # X1 取值范围
X2 <- seq(-3, 3, length.out = 30)  # X2 取值范围
grid <- expand.grid(X1 = X1, X2 = X2)
# 定义回归模型 Y = β0 + β1*X1 + β2*X2 + β3*X1*X2
beta0 <- 2
beta1 <- 1
beta2 <- 1
beta3 <- 2  # 交互项系数（控制曲面的弯曲程度）
# 计算 Y 值
grid$Y <- beta0 + beta1 * grid$X1 + beta2 * grid$X2 + beta3 * (grid$X1 * grid$X2)
# 绘制 3D 交互效应曲面图
plot_ly(grid, x = ~X1, y = ~X2, z = ~Y, type = "surface") %>%
layout(
title = "交互项 X1 * X2 生成的曲面",
scene = list(
xaxis = list(title = "X1"),
yaxis = list(title = "X2"),
zaxis = list(title = "Y")
)
)
# 加载必要的库
library(ggplot2)
library(plotly)
# 生成更大的数据范围
X1 <- seq(-5, 5, length.out = 50)  # X1 取值范围更大
X2 <- seq(-5, 5, length.out = 50)  # X2 取值范围更大
grid <- expand.grid(X1 = X1, X2 = X2)
# 定义回归模型 Y = β0 + β1*X1 + β2*X2 + β3*X1*X2
beta0 <- 2
beta1 <- 1
beta2 <- 1
beta3 <- 3  # 交互项系数（加大交互项，增强曲面效果）
# 计算 Y 值
grid$Y <- beta0 + beta1 * grid$X1 + beta2 * grid$X2 + beta3 * (grid$X1 * grid$X2)
# 绘制 3D 交互效应曲面图
plot_ly(grid, x = ~X1, y = ~X2, z = ~Y, type = "surface", colorscale = "Viridis") %>%
layout(
title = "交互项 X1 * X2 生成的曲面",
scene = list(
xaxis = list(title = "X1"),
yaxis = list(title = "X2"),
zaxis = list(title = "Y")
)
)
# 生成数据
X1 <- seq(-5, 5, length.out = 50)  # X1 取值范围
X2 <- seq(-5, 5, length.out = 50)  # X2 取值范围
Y <- outer(X1, X2, function(x1, x2) 2 + 1*x1 + 1*x2 + 3*(x1*x2))  # 计算 Y
# 绘制 3D 曲面
