# 1) 扫描 tests 目录里可能的文本文件，找含 NUL 的
paths <- list.files("tests", pattern = "\\.(R|Rmd|txt|md|csv)$",
recursive = TRUE, full.names = TRUE)
has_nul <- function(p) {
raw <- readBin(p, what = "raw", n = file.info(p)$size)
any(raw == as.raw(0x00))
}
bad <- paths[vapply(paths, has_nul, logical(1))]
bad
# 扫描整个包（排除常见生成物/二进制目录）
ignore_dirs <- c("^\\.git", "^\\.Rproj\\.user", "^docs", "^inst/doc", "^revdep")
all <- list.files(".", recursive = TRUE, all.files = FALSE, full.names = TRUE)
all <- all[!dir.exists(all)]
all <- all[!grepl(paste(ignore_dirs, collapse="|"), all)]
# 排除明显二进制扩展名（可按需增减）
bin_ext <- c("png","jpg","jpeg","gif","pdf","zip","tar","gz","7z","rds","RData","ico")
all2 <- all[!grepl(paste0("\\.(", paste(bin_ext, collapse="|"), ")$"), tolower(all))]
has_nul <- function(p) {
sz <- file.info(p)$size
if (is.na(sz) || sz == 0) return(FALSE)
x <- readBin(p, what = "raw", n = sz)
any(x == as.raw(0x00))
}
has_utf16_bom <- function(p) {
sz <- file.info(p)$size
if (is.na(sz) || sz < 2) return(FALSE)
x <- readBin(p, what = "raw", n = 2)
# UTF-16 LE BOM = FF FE; UTF-16 BE BOM = FE FF
(identical(x, as.raw(c(0xFF,0xFE))) || identical(x, as.raw(c(0xFE,0xFF))))
}
bad_nul  <- all2[vapply(all2, has_nul,  logical(1))]
bad_bom  <- all2[vapply(all2, has_utf16_bom, logical(1))]
unique(c(bad_nul, bad_bom))
text_like <- function(p) {
# 先用扩展名过滤
ok_ext <- grepl("\\.(R|Rmd|Rd|md|txt|csv|yml|yaml|json|Rproj)$", tolower(p))
if (!ok_ext) return(FALSE)
# 再用 NUL 探测（含 NUL 的一律视为二进制，跳过）
sz <- file.info(p)$size
if (is.na(sz) || sz == 0) return(FALSE)
x <- readBin(p, "raw", n = sz)
!any(x == as.raw(0x00))
}
paths <- list.files(".", recursive = TRUE, full.names = TRUE)
paths <- paths[!dir.exists(paths)]
txt_files <- paths[vapply(paths, text_like, logical(1))]
# 现在只对 txt_files 做 readLines()/iconv() 等文本检查
