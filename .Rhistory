devtools::document()
find_function_file <- function(fun_name, path = "R") {
files <- list.files(path, pattern = "\\.R$", full.names = TRUE)
for (f in files) {
lines <- readLines(f, warn = FALSE)
matches <- grep(paste0("^", fun_name, "\\s*<-\\s*function"), lines)
if (length(matches) > 0) {
cat("Found in:", f, "\nLine(s):", matches, "\n")
return(invisible(f))
}
}
cat("Function", fun_name, "not found in", path, "\n")
}
