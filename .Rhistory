model <- '
M ~ a1*X + c1*W + c2*XW
Y ~ b*M + c*X
'
wp.mc.sem.basic(model = model, indirect = "a1*b + c2*b*W", nobs = 250, nrep = 1500, alpha = 0.05)
# 定义带调节的中介模型
model <- '
M ~ a1*X + c2*X*W
Y ~ b*M + c3*X + d1*W
'
# 运行 Monte Carlo SEM 功效分析
wp.mc.sem.basic(model = model, indirect = "a1*b", nobs = 250, nrep = 1500, alpha = 0.05)
# 定义简单中介模型
model <- '
M ~ a1*X
Y ~ b*M + c1*X
'
# 运行 Monte Carlo SEM 功效分析（仅计算 X → M → Y）
wp.mc.sem.basic(model = model, indirect = "a1*b",
nobs = 250, nrep = 1500, alpha = 0.05)
??wp.mc.sem.basic
demo ="
y ~ cp*x + start(0)*x + b*m + start(0.39)* m
m ~ a*x + start(0.39)*x
x ~~ start(1)*x
m ~~ start(1)*m
y ~~ start(1)*y
"
#To specify the indirect effects
mediation = "
ab := a*b
abc:= a*b + cp
"
#To calculate power for mediation using regular standard errors
## change nrep to at least 1,000 in real data analysis
sobel.regular = wp.mc.sem.basic(model=demo, indirect=mediation, nobs=100, nrep=10,
skewness=c(0, 0, 1.3), kurtosis=c(0,0,10), ovnames=c("x","m","y"))
demo ="
y ~ cp*x + start(0)*x + b*m + start(0.39)* m
m ~ a*x + start(0.39)*x
x ~~ start(1)*x
m ~~ start(1)*m
y ~~ start(1)*y
"
#To specify the indirect effects
mediation = "
ab := a*b
abc:= a*b + cp
abcd := a + b
"
sobel.regular = wp.mc.sem.basic(model=demo, indirect=mediation, nobs=100, nrep=10,
skewness=c(0, 0, 1.3), kurtosis=c(0,0,10), ovnames=c("x","m","y"))
sobel.regular = wp.mc.sem.basic(model=demo, nobs=100, nrep=10,
skewness=c(0, 0, 1.3), kurtosis=c(0,0,10), ovnames=c("x","m","y"))
